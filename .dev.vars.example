# Worker が読む秘密。ローカル用のコピー元。
# 本番の値はここではなく `wrangler secret put <名前>` で入れる。

# 本番で room-simulator と Cookie を共有するときだけ
# <account>.workers.dev を設定する。ローカルは空のままにする。
SESSION_COOKIE_DOMAIN=

# 回答を書くモデルの API キー。空でも起動はするが、チャットが 500 で返る。
# キーの「存在」だけで worker-configuration.d.ts の差分が消えるので、
# 回答の生成を手で確かめないうちはダミー値でよい。
LLM_API_KEY=dummy

# 接続先とモデル。空のままなら DeepSeek (https://api.deepseek.com /
# deepseek-v4-flash) になるので、DeepSeek を使うなら空でよい。
# OpenAI 互換の API ならここを埋めるだけで切り替わる (例:
# https://api.openai.com/v1 と gpt-5.2)。
# キーを消して書かないでいると worker-configuration.d.ts に差分が出るので、
# 使わないときも行ごと残して値だけ空にすること。
LLM_BASE_URL=
LLM_MODEL=

# Responses API の web_search ツールを持たないプロバイダに向けるときだけ
# "false" にする。設定メニューから Web 検索のトグルが消え、常に
# /chat/completions で尋ねるようになる。空なら対応しているものとして扱う。
LLM_WEB_SEARCH_SUPPORTED=

# ログイン。この 3 つのどれかが空だと API は全部 401 のまま閉じる
# (設定を忘れたまま公開してしまう事故を防ぐため)。
AUTH_USERNAME=demo
AUTH_PASSWORD=demo
# セッション Cookie の署名鍵。ローカルは何でもよい。
# 本番はランダムな長い値にすること。入れ替えると全端末がログアウトする
# (端末を失くしたときの唯一の取り消し手段)。
AUTH_SESSION_SECRET=local-development-only
